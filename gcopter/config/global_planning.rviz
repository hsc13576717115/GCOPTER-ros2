Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Tool Properties
  Name: Tool Properties
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: odom
    Background Color: 35; 38; 45
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1.0
    Plane: XY
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/PointCloud2
    Name: Obstacle map
    Enabled: true
    Topic:
      Value: /voxel_map
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 10
    Style: Boxes
    Size (m): 0.25
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Axis: Z
    Queue Size: 10
  - Class: rviz_default_plugins/Marker
    Name: route
    Enabled: true
    Topic:
      Value: /visualizer/route
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 10
    Namespaces: {}
  - Class: rviz_default_plugins/Marker
    Name: waypoints
    Enabled: true
    Topic:
      Value: /visualizer/waypoints
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 10
    Namespaces: {}
  - Class: rviz_default_plugins/Marker
    Name: mesh
    Enabled: true
    Topic:
      Value: /visualizer/mesh
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 10
    Namespaces: {}
  - Class: rviz_default_plugins/Marker
    Name: edge
    Enabled: true
    Topic:
      Value: /visualizer/edge
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 10
    Namespaces: {}
  - Class: rviz_default_plugins/Marker
    Name: trajectory
    Enabled: true
    Topic:
      Value: /visualizer/trajectory
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 10
    Namespaces: {}
  - Class: rviz_default_plugins/Marker
    Name: spheres
    Enabled: true
    Topic:
      Value: /visualizer/spheres
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 10
    Namespaces: {}
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: /move_base_simple/goal
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 85.0
      Pitch: 1.15
      Yaw: 0.8
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 1.5
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1100
  Height: 800
  X: 30
  Y: 30
